# cp .env.example .env

# --- LLM provider (chọn 1) ---
# Ưu tiên Gemini nếu có GOOGLE_API_KEY, ngược lại dùng OpenAI. Xem src/llm.py.

# Google Gemini — dùng cho M4 (RAGAS judge), M5 (enrichment), sinh câu trả lời
GOOGLE_API_KEY=AIza...
GEMINI_CHAT_MODEL=gemini-2.0-flash
# Judge của RAGAS — dùng model khác generator (quota riêng + tránh self-preference bias)
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=models/text-embedding-004

# OpenAI (tuỳ chọn — chỉ cần nếu không dùng Gemini)
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Tuning ---
# Số request RAGAS chạy song song (giữ thấp để tránh 429 trên free tier)
RAGAS_MAX_WORKERS=2
LLM_MAX_RETRIES=5
# Số request tối đa/phút — free tier Gemini = 15
LLM_RPM=14
